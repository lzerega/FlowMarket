{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "catalog-db",
    "Port": 5432,
    "DatabaseName": "catalogdb",
    "Username": "{dbUser}",
    "Password": "{dbPass}"
  },
  "OpenTelemetry": {
    "Endpoint": "http://otel-collector:4317",
    "ServiceName": "catalog-api"
  }
}
